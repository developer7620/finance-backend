{
  "name": "finance-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Finance dashboard backend built with Node.js, Express, TypeScript, Prisma, PostgreSQL, JWT, and Zod.",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "npm run test:integration",
    "test:integration": "dotenv -e .env.test -- vitest run --config vitest.config.ts",
    "test:watch": "dotenv -e .env.test -- vitest --config vitest.config.ts",
    "test:db:reset": "dotenv -e .env.test -- prisma db push --force-reset --skip-generate && dotenv -e .env.test -- prisma db seed",
    "docker:up": "docker compose up -d postgres",
    "docker:down": "docker compose down -v",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.7.0",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.14",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv-cli": "^7.4.4",
    "prisma": "^6.6.0",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
